generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  LAWYER
  INTERN
  ADMIN
}

enum TaskStatus {
  ATANDI
  INCELEME_BEKLIYOR
  KONTROL_EDILECEK
  REVIZE_ISTENDI
  ONAYLANDI
  GONDERIM_BEKLIYOR
  TAMAMLANDI
}

enum ClientCallStatus {
  YOK
  ARANACAK
  YAPILDI
}

enum FileKind {
  INSTRUCTION
  DRAFT
}

enum CourthouseJobKind {
  GORUSME
  IS
}

enum LogType {
  CREATED
  ACCEPTED
  DRAFT_UPLOADED
  SENT_TO_LAWYER
  MOVED_TO_CHECK
  COMPLETED_DIRECT
  REVISION_REQUESTED
  APPROVED
  EXPENSE_MARKED
  CLIENT_CALL_UPDATED
  SEND_QUEUED
  COMPLETED
  DELETED
  SOFT_DELETED
  RESTORED
  FORWARDED
}

model User {
  id           String   @id
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  /// Parola değişince eski oturumlar düşer
  passwordUpdatedAt DateTime @default(now())
  role         Role
  title        String
  /// Avukatın kendi Drive klasörü (isteğe bağlı)
  driveFolderId String?
  /// Klasörün tarayıcı bağlantısı (stajyer erişimi için)
  driveFolderLink String?
  /// OAuth refresh token (isteğe bağlı; bağlandığında dolar)
  driveRefreshToken String?
  driveConnectedAt  DateTime?
  createdAt    DateTime @default(now())

  assignedTasks Task[]         @relation("Assignee")
  createdTasks  Task[]         @relation("Assigner")
  workItems     WorkItem[]
  workItemEntries WorkItemEntry[]
  clients       Client[]
  clientNotes   ClientNote[]
  comments      TaskComment[]
  logs          TaskLog[]
  files         TaskFile[]
  notifications Notification[]
  courthouseJobsAssigned  CourthouseJob[] @relation("CourthouseAssignee")
  courthouseJobsCreated   CourthouseJob[] @relation("CourthouseAssigner")
  courthouseJobsCompleted CourthouseJob[] @relation("CourthouseCompleter")
  internScores            TaskScore[]           @relation("InternScores")
  givenScores             TaskScore[]           @relation("LawyerGivenScores")
  questsCreated           InternQuest[]
  questAnswers            InternQuestAnswer[]   @relation("QuestIntern")
  questGrades             InternQuestAnswer[]   @relation("QuestScorer")
}

/// Büro geneli ayarlar (Drive servis hesabı vb.) — yalnızca Halil günceller
model OfficeConfig {
  id                      String   @id @default("office")
  driveServiceAccountEnc  String?
  driveFolderId           String?
  driveServiceEmail       String?
  updatedAt               DateTime @updatedAt
  updatedById             String?
}

/// JSON içe aktarım izi — aynı taraf tekrar eklenmez; hash değişince güncellenir
model ImportFingerprint {
  id          String   @id @default(cuid())
  kind        String
  externalKey String
  contentHash String
  clientId    String?
  meta        String   @default("")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([kind, externalKey])
  @@index([kind])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  /// Türkçe duyarsız eşleştirme anahtarı (tekrar eklemeyi önler)
  nameKey   String    @default("")
  ownerId   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner     User         @relation(fields: [ownerId], references: [id])
  caseFiles CaseFile[]
  notes     ClientNote[]
  workItems WorkItem[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([nameKey])
  @@index([deletedAt])
}

/// Müvekkil hakkında avukat/stajyer notları
model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([clientId])
  @@index([authorId])
}

model CaseFile {
  id         String    @id @default(cuid())
  clientId   String
  fileNumber String
  courtName  String    @default("")
  notes      String    @default("")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@unique([clientId, fileNumber])
  @@index([clientId])
  @@index([fileNumber])
  @@index([deletedAt])
}

model WorkItem {
  id            String    @id @default(cuid())
  clientName    String
  clientId      String?
  opposingParty String
  courtName     String
  fileNumber    String
  courtFile     String
  workToDo      String
  notes         String    @default("")
  ownerId       String
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner   User            @relation(fields: [ownerId], references: [id])
  client  Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks   Task[]
  entries WorkItemEntry[]

  @@index([ownerId])
  @@index([clientId])
  @@index([completedAt])
}

model WorkItemEntry {
  id          String   @id @default(cuid())
  workItemId  String
  content     String
  createdById String
  createdAt   DateTime @default(now())

  workItem  WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([workItemId])
}

model Task {
  id           String     @id @default(cuid())
  title        String
  clientName   String
  fileNumber   String
  description  String
  dueDate      DateTime
  status       TaskStatus @default(ATANDI)
  assignerId   String
  assigneeId   String
  workItemId   String?
  caseFileId   String?
  trackingCode String?
  listColor    String?
  acceptedAt   DateTime?
  completedAt  DateTime?
  deletedAt    DateTime?
  expensePaid       Boolean          @default(false)
  expensePaidAt     DateTime?
  clientCallStatus  ClientCallStatus @default(YOK)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assigner      User           @relation("Assigner", fields: [assignerId], references: [id])
  assignee      User           @relation("Assignee", fields: [assigneeId], references: [id])
  workItem      WorkItem?      @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  caseFile      CaseFile?      @relation(fields: [caseFileId], references: [id], onDelete: SetNull)
  comments      TaskComment[]
  logs          TaskLog[]
  files         TaskFile[]
  notifications Notification[]
  score         TaskScore?

  @@index([assignerId])
  @@index([assigneeId])
  @@index([status])
  @@index([workItemId])
  @@index([caseFileId])
  @@index([dueDate])
  @@index([deletedAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model TaskLog {
  id         String    @id @default(cuid())
  taskId     String
  actorId    String
  type       LogType
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  note       String?
  meta       String?
  createdAt  DateTime  @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId])
}

model TaskFile {
  id           String   @id @default(cuid())
  taskId       String
  kind         FileKind
  driveFileId  String   @unique
  name         String
  mimeType     String
  size         Int
  webViewLink  String
  storageMode  String
  uploadedById String
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

/// Avukatın tamamlanan stajyer işine verdiği puan (XP)
model TaskScore {
  id        String   @id @default(cuid())
  taskId    String   @unique
  internId  String
  lawyerId  String
  points    Int
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  intern User @relation("InternScores", fields: [internId], references: [id], onDelete: Cascade)
  lawyer User @relation("LawyerGivenScores", fields: [lawyerId], references: [id])

  @@index([internId])
}

/// Avukatın stajyerlere açtığı araştırma görevi
model InternQuest {
  id          String    @id @default(cuid())
  title       String
  prompt      String
  createdById String
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User                @relation(fields: [createdById], references: [id])
  answers   InternQuestAnswer[]

  @@index([createdById])
  @@index([closedAt])
}

model InternQuestAnswer {
  id         String    @id @default(cuid())
  questId    String
  internId   String
  body       String
  points     Int?
  scoredById String?
  scoredAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  quest    InternQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  intern   User        @relation("QuestIntern", fields: [internId], references: [id], onDelete: Cascade)
  scoredBy User?       @relation("QuestScorer", fields: [scoredById], references: [id])

  @@unique([questId, internId])
  @@index([internId])
}

/// Büro adliyeleri — yalnızca yönetici ekler
model Courthouse {
  id        String   @id @default(cuid())
  name      String
  city      String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs CourthouseJob[]

  @@index([name])
}

/// Adliyede görüşme veya işlem — stajyerler tüm açık işleri görür ve tamamlayabilir
model CourthouseJob {
  id            String            @id @default(cuid())
  courthouseId  String
  kind          CourthouseJobKind @default(IS)
  title         String
  description   String            @default("")
  clientName    String            @default("")
  fileNumber    String            @default("")
  dueDate       DateTime?
  assignerId    String
  assigneeId    String?
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  courthouse  Courthouse @relation(fields: [courthouseId], references: [id], onDelete: Cascade)
  assigner    User       @relation("CourthouseAssigner", fields: [assignerId], references: [id])
  assignee    User?      @relation("CourthouseAssignee", fields: [assigneeId], references: [id])
  completedBy User?      @relation("CourthouseCompleter", fields: [completedById], references: [id])

  @@index([courthouseId])
  @@index([assigneeId])
  @@index([assignerId])
  @@index([completedAt])
  @@index([dueDate])
}

/// Tehlikeli toplu işlem öncesi yedek — geri yükleme için
model DataSnapshot {
  id        String   @id @default(cuid())
  kind      String
  label     String
  payload   String
  createdBy String
  createdAt DateTime @default(now())
  restoredAt DateTime?

  @@index([kind, createdAt])
}
