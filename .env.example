DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST=true
AUTH_URL="https://your-domain.example"

# İkisi birden doluysa yükleme Google Drive'a gider.
# Servis hesaplarının kendi Drive kotası yoktur; klasörü gerçek bir Drive'da oluşturup
# servis hesabı e-postasıyla Düzenleyici olarak paylaşın.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# private (varsayılan) veya anyone
DRIVE_SHARE_MODE=private

# true yazılırsa girişte deneme hesapları görünür. Üretimde boş bırakın.
DEMO_LOGIN=

# İsteğe bağlı: Vercel env ile büro Drive (Halil Ayarlar’dan da bağlanabilir)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_DRIVE_FOLDER_ID=
